    "offset_axes": "positive_x_right_positive_y_down_in_display_pixels",
    "scale_reference": "oriented_overlay_source",
    "alpha": "straight_8bit_RGBA_source_over_in_encoded_channel_space_no_linear_light_conversion",
    "opacity": "if opacity < 0.999 multiply each overlay alpha by opacity and round half to even; otherwise leave alpha unchanged",
    "alpha_validation": "genuine_PNG_but_no_required_transparent_or_opaque_pixel_count",
    "clipping": "intersect_with_base_canvas_without_resizing_base; empty_intersection_is_valid",
